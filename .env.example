# DuoCinema - Environment Configuration
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to version control.

# Supabase Project Configuration (Find these in Supabase Dashboard -> Project Settings -> API)
# Both values are public and browser-safe. Row Level Security (RLS) protects database access.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Note: DO NOT put service_role or admin secret keys here. They are strictly prohibited in frontend client applications.
